local function makeButton(text, y)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, -24, 0, 42)
	button.Position = UDim2.fromOffset(12, y)
	button.BackgroundColor3 = Color3.fromRGB(105, 10, 25)
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.GothamBold
	button.TextSize = 13
	button.Text = text
	button.Parent = frame

	Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)
	return button
end

local teleportButton = makeButton("TELEPORT TO ALIEN BOSS", 48)
local followButton = makeButton("AUTO FOLLOW: OFF", 96)
local punchButton = makeButton("AUTO PUNCH: OFF", 144)

teleportButton.MouseButton1Click:Connect(function()
	local boss = getBoss()
	if not boss then
		teleportButton.Text = "ALIEN BOSS NOT FOUND"
		task.wait(2)
		teleportButton.Text = "TELEPORT TO ALIEN BOSS"
		return
	end

	local _, _, bossRoot = getBoss()
	if root and bossRoot then
		root.CFrame = bossRoot.CFrame * CFrame.new(0, 0, 5)
	end
end)

followButton.MouseButton1Click:Connect(function()
	autoFollow = not autoFollow
	followButton.Text = "AUTO FOLLOW: " .. (autoFollow and "ON" or "OFF")
end)

punchButton.MouseButton1Click:Connect(function()
	autoPunch = not autoPunch
	punchButton.Text = "AUTO PUNCH: " .. (autoPunch and "ON" or "OFF")
end)

RunService.Heartbeat:Connect(function()
	if not root or not humanoid or humanoid.Health <= 0 then return end

	local boss, bossHumanoid, bossRoot = getBoss()
	if not boss then return end

	local distance = (root.Position - bossRoot.Position).Magnitude

	if autoFollow and distance > 5 then
		humanoid:MoveTo(bossRoot.Position - bossRoot.CFrame.LookVector * 5)
	end

	if autoPunch and distance <= attackRange then
		if os.clock() - lastAttack >= attackCooldown then
			lastAttack = os.clock()

			-- PLACEHOLDER:
			-- Connect your game's actual punch input/damage system here.
			-- A LocalScript cannot safely lower server-owned boss health.
		end
	end
end)

